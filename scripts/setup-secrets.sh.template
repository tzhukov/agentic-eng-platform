#!/bin/bash
# Template for setting up Kubernetes secrets for the agent.
# Copy this to setup-secrets.sh and fill in your keys.

NAMESPACE="agent-system"

# Ensure namespace exists
kubectl create namespace ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -

# Agent Credentials
kubectl create secret generic agent-secrets \
  --namespace ${NAMESPACE} \
  --from-literal=E2B_API_KEY="your-e2b-api-key" \
  --from-literal=GOOGLE_API_KEY="your-google-api-key" \
  --from-literal=LANGFUSE_PUBLIC_KEY="your-langfuse-public-key" \
  --from-literal=LANGFUSE_SECRET_KEY="your-langfuse-secret-key" \
  --from-literal=LANGFUSE_HOST="http://localhost:3000" \
  --dry-run=client -o yaml | kubectl apply -f -

echo "Secrets created in namespace ${NAMESPACE}."
